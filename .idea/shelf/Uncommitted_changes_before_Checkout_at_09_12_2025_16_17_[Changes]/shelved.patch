-
-        if (!player.vitals.isAlive()) {
-            throw new IllegalStateException("Player is dead and cannot move");
-        }
-
-        int newCol = col;
-        int newRow = row;
-
-        switch (direction) {
-            case UP:
-                newRow--;
-                break;
-            case DOWN:
-                newRow++;
-                break;
-            case LEFT:
-                newCol--;
-                break;
-            case RIGHT:
-                newCol++;
-                break;
