-    }
-
-    public int hydration() {
-        return hydration;
-    }
-
-    public void hydrate(int amount){
-        if (amount < 0)
-            throw new IllegalArgumentException("Amount cannot be negative");
-        hydration = Math.min(hydration + amount, 100);
-    }
-
